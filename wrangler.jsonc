{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "okazuri-bot",
    "main": "src/index.ts",
    "compatibility_date": "2025-01-09",
    "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
    "workers_dev": true,
    "preview_urls": true,
    "keep_vars": true,
    "observability": { "enabled": true },
    "placement": {
        "region": "aws:ap-northeast-1",
    },
    // 毎日 00:00 UTC(09:00 JST)に、自分の POST /internal/fetch-magazines を呼んで差分取得を起爆する。
    // cron 自体は国外で動くが、自分宛ての fetch は global_fetch_strictly_public で外部からの扱いになり、
    // placement で日本の拠点に回る。外部のサーバー(okazuri-search-api の cron)から同じ URL を呼んでもよい
    "triggers": { "crons": ["0 0 * * *"] },
    // DLsite のレーベルID。新しいレーベルはここに足すだけでよい(名前・進捗は初回の取得で DB に作られる)
    "vars": {
        // 自分自身の URL(取得を子の呼び出しに分けるときに呼ぶ)
        "WORKER_URL": "https://okazuri-bot.naecqde.workers.dev",
        "MAGAZINE_IDS": [
            "LBL02690", // COMIC快楽天
            "LBL02558", // COMIC快楽天ビースト
            "LBL02655", // COMIC失楽天
            "LBL00611", // COMIC E×E
            "LBL03007", // COMICペンギンクラブ
            "LBL03712", // コミックグレープ
            "LBL02544", // COMIC ゼロス(旧 COMIC X-EROS)
            "LBL00255", // comicアンスリウム
            "LBL02053", // comicクリベロン DUMA
            "LBL01003", // コミックマグナム
            "LBL00334", // COMICエウロパ
        ],
    },
    // 静的なサイト(site/: トップ、/dev、/search、/invite、/add)は Workers の静的アセットとして配る。アセットの配信は無料で、Worker の呼び出しに数えない。
    // Worker が動くのは run_worker_first のパスだけ(BOT)
    "assets": {
        "directory": "./site",
        "binding": "ASSETS",
        // /dev/ ではなく /dev(末尾の / なし)で配る。/dev/ は /dev に転送される
        "html_handling": "drop-trailing-slash",
        // アセットにないパスは 404.html を返す(Worker を呼ばないので、無駄な呼び出しが増えない)
        "not_found_handling": "404-page",
        // 検索語(?q=)つきの /search と /ja/search は、Cloudflare の URL Rewrite ルールがボットのときだけ /__og/... に書き換えて、リンクの埋め込み(OGP)のタイトルに検索語を入れるために Worker を通す。ふつうの検索ページは静的アセットで、Worker を呼ばない
        "run_worker_first": ["/api/bot/interaction*", "/api/bot/internal/*", "/interaction*", "/internal/*", "/__og/*"],
    },
    "routes": [
        // okazuri.nae.quest のうち Worker(静的アセットと BOT)に割り当てるパスだけを並べる。/api/v1/* などそれ以外は、Worker を通らず webarena に届く
        { "pattern": "okazuri.nae.quest/api/bot/interaction*", "zone_name": "nae.quest" },
        { "pattern": "okazuri.nae.quest/api/bot/internal/*", "zone_name": "nae.quest" },
        { "pattern": "okazuri.nae.quest/", "zone_name": "nae.quest" },
        // 英語が /, /search, /dev。日本語は /ja, /ja/search, /ja/dev
        { "pattern": "okazuri.nae.quest/search*", "zone_name": "nae.quest" },
        { "pattern": "okazuri.nae.quest/dev*", "zone_name": "nae.quest" },
        { "pattern": "okazuri.nae.quest/ja*", "zone_name": "nae.quest" },
        { "pattern": "okazuri.nae.quest/__og/*", "zone_name": "nae.quest" },
        { "pattern": "okazuri.nae.quest/style.css", "zone_name": "nae.quest" },
        { "pattern": "okazuri.nae.quest/primer.css", "zone_name": "nae.quest" },
        { "pattern": "okazuri.nae.quest/og.png", "zone_name": "nae.quest" },
    ],
    "d1_databases": [
        {
            "binding": "DB",
            "database_name": "okazuri",
            "database_id": "f9dc2cfe-17c9-4b58-baf8-692971f19304",
            "migrations_dir": "drizzle/migrations",
        },
    ],
}
